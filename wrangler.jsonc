{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brackets",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brackets",
      "database_id": "5a488bc1-da45-4e96-9d32-aebdfc746326"
    }
  ],
  "triggers": {
    // Backstop for the Apps Script webhook: pick up sheet edits within a minute.
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
